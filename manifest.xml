<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>F3B41A79-E116-495A-85FC-01AC1D4A5D50</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>UXpert</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="RTL Default" />
  <Description DefaultValue="Forces new messages, replies, and forwards to compose right-to-left." />
  <IconUrl DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/" />

  <!-- Hosts this add-in runs in. -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <!-- Baseline requirement so legacy clients can load the add-in at all. -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <!-- Legacy form settings, required by the schema for older clients. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/commands.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadWriteItem is required to modify the message body on compose. -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Legacy activation rule for clients that don't support VersionOverrides. -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <!-- OnMessageCompose requires Mailbox 1.12. -->
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <!-- Event-based activation runs in a lightweight runtime. -->
          <Runtimes>
            <!-- HTML runtime used by Outlook on the web, New Outlook on Mac, and new Outlook on Windows. -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- JS-only runtime, used by classic Outlook on Windows. -->
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />

            <!-- Fire our handler whenever a message is composed (new / reply / replyAll / forward). -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onMessageComposeHandler" />
              </LaunchEvents>
              <!-- Must match the Runtime resid for the browser runtime. -->
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/assets/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/assets/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/commands.html" />
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/commands.html" />
          <!-- Used only by classic Outlook on Windows. -->
          <bt:Url id="JSRuntime.Url" DefaultValue="https://uxpert-yossi.github.io/Outlook-RTL/src/launchevent.js" />
        </bt:Urls>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
